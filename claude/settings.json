{
  "permissions": {
    "ask": [
      "mcp__logseq-admin"
    ]
  },
  "model": "sonnet",
  "disableClaudeAiConnectors": true,
  "syncClaudeAiSkills": false,
  "claudeMdExcludes": [
    "/home/conspicio/dotfiles/CLAUDE.md",
    "/home/conspicio/context/CLAUDE.local.md"
  ],
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dotfiles/claude/mods/agents-board",
    "CLAUDE_CODE_DISABLE_ARTIFACT": "1"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/context/claude/hooks/token-usage.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/context/claude/hooks/repo-pull.py",
            "async": true
          }
        ]
      }
    ]
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "autoCompactWindow": 400000
    }
  },
  "advisorModel": "opus",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "autoUpdates": false
}
